# Desarrollo local. Sustituye todos los secretos al desplegar.
DJANGO_SECRET_KEY=replace-with-a-local-development-only-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Producción: define orígenes HTTPS separados por coma. Las cookies son seguras
# automáticamente cuando DJANGO_DEBUG=false; solo define esta variable para anularlo.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Coinciden con infra/compose.yaml. Exclusivos del entorno local.
POSTGRES_DB=modulo
POSTGRES_USER=modulo
POSTGRES_PASSWORD=modulo_dev
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
